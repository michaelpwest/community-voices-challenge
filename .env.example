# Copy this file to .env and adjust as needed. Never commit .env.

# Local servers
WEB_PORT=3000
API_PORT=3001
# Whether "npm start" opens the web UI in your browser (true or false; yes/no, on/off, and 1/0 also work)
OPEN_BROWSER=true

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window, applied identically to baseline and RAG runs
OLLAMA_NUM_CTX=16384

# Storage: SQLite file with sqlite-vec
DATABASE_PATH=./data/community-voices.db

# Community source: Lemmy public API
LEMMY_INSTANCE_URL=https://lemmy.world
LEMMY_COMMUNITY=games
# Sent with every request so the instance can identify this app
LEMMY_USER_AGENT=community-voices/0.1 (local weekly community report demo)
# Top-scored comments kept per post (0-50)
LEMMY_COMMENTS_PER_POST=10
