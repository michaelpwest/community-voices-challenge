# Copy this file to .env and adjust as needed. Never commit .env.

# Local servers
WEB_PORT=3000
API_PORT=3001

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window, applied identically to baseline and RAG runs
OLLAMA_NUM_CTX=16384

# Storage: SQLite file with sqlite-vec
DATABASE_PATH=./data/community-voices.db

# Community source: Lemmy public API
LEMMY_INSTANCE_URL=https://lemmy.world
LEMMY_COMMUNITY=games
